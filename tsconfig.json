{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "./src",
    "typeRoots": ["./node_modules/@types", "./@types"],
    "paths": {
      "@features/*": ["features/*"],
      "@assets/*": ["assets/*"],
      "@hooks/*": ["global/hooks/*"],
      "@services/*": ["global/services/*"],
      "@stores/*": ["global/stores/*"],
      "@styles/*": ["global/styles/*"],
      "@models/*": ["global/models/*"],
      "@components/*": ["global/components/*"],
      "@utils/*": ["global/utils/*"],
      "@navigation/*": ["navigation/*"]
    },
    "strict": true
  }
}
